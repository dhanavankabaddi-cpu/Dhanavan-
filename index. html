<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ShopKart - Online Store</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- LOGIN PAGE -->
    <div id="loginPage" class="login-page">

        <div class="login-box">

            <h1>ShopKart</h1>
            <p class="subtitle">Welcome back!</p>

            <input
                type="text"
                id="username"
                placeholder="Username"
            >

            <input
                type="password"
                id="password"
                placeholder="Password"
            >

            <button onclick="login()">Login</button>

            <p id="loginMessage"></p>

            <p class="demo">
                Demo: any username + password
            </p>

        </div>

    </div>


    <!-- MAIN WEBSITE -->
    <div id="storePage" class="hidden">

        <!-- HEADER -->
        <header>

            <div class="logo">
                ShopKart
            </div>

            <div class="search-container">
                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search products..."
                    onkeyup="searchProducts()"
                >

                <button onclick="searchProducts()">
                    🔍
                </button>
            </div>

            <div class="header-buttons">

                <button onclick="showCart()">
                    🛒 Cart (<span id="cartCount">0</span>)
                </button>

                <button onclick="logout()">
                    Logout
                </button>

            </div>

        </header>


        <!-- CATEGORY BAR -->
        <nav class="categories">

            <button onclick="filterProducts('all')">
                All
            </button>

            <button onclick="filterProducts('electronics')">
                Electronics
            </button>

            <button onclick="filterProducts('fashion')">
                Fashion
            </button>

            <button onclick="filterProducts('home')">
                Home
            </button>

            <button onclick="filterProducts('sports')">
                Sports
            </button>

        </nav>


        <!-- HERO SECTION -->
        <section class="hero">

            <div>
                <h1>Big Deals, Better Prices!</h1>

                <p>
                    Discover amazing products at great prices.
                </p>

                <button onclick="scrollToProducts()">
                    Shop Now
                </button>
            </div>

        </section>


        <!-- PRODUCTS -->
        <main>

            <h2 id="productsTitle">
                Featured Products
            </h2>

            <div
                id="productContainer"
                class="products">
            </div>

        </main>


        <!-- CART -->
        <div id="cartPanel" class="cart-panel">

            <div class="cart-header">

                <h2>Your Cart</h2>

                <button onclick="closeCart()">
                    ✕
                </button>

            </div>

            <div id="cartItems"></div>

            <div class="cart-total">

                <h3>
                    Total:
                    ₹<span id="cartTotal">0</span>
                </h3>

                <button onclick="checkout()">
                    Proceed to Checkout
                </button>

            </div>

        </div>


        <!-- FOOTER -->
        <footer>

            <h2>ShopKart</h2>

            <p>
                Your simple online shopping destination.
            </p>

            <p>
                © 2026 ShopKart. All rights reserved.
            </p>

        </footer>

    </div>


    <script src="script.js"></script>

</body>
</html>
