* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #222;
}

/* LOGIN */

.login-page {
    height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: linear-gradient(
        135deg,
        #131921,
        #232f3e
    );
}

.login-box {
    width: 350px;

    background: white;

    padding: 35px;

    border-radius: 12px;

    box-shadow: 0 10px 30px rgba(0,0,0,0.3);

    text-align: center;
}

.login-box h1 {
    color: #ff9900;

    margin-bottom: 8px;
}

.subtitle {
    margin-bottom: 25px;

    color: #666;
}

.login-box input {
    width: 100%;

    padding: 13px;

    margin-bottom: 15px;

    border: 1px solid #ccc;

    border-radius: 6px;

    font-size: 15px;
}

.login-box button {
    width: 100%;

    padding: 13px;

    border: none;

    border-radius: 6px;

    background: #ff9900;

    color: #111;

    font-weight: bold;

    cursor: pointer;
}

.login-box button:hover {
    background: #ffad33;
}

#loginMessage {
    margin-top: 12px;
    color: red;
}

.demo {
    margin-top: 20px;

    font-size: 12px;

    color: #777;
}


/* HIDDEN */

.hidden {
    display: none;
}


/* HEADER */

header {
    background: #131921;

    color: white;

    padding: 15px 25px;

    display: flex;

    align-items: center;

    gap: 20px;

    position: sticky;

    top: 0;

    z-index: 100;
}

.logo {
    font-size: 26px;

    font-weight: bold;

    color: #ff9900;

    min-width: 120px;
}

.search-container {
    flex: 1;

    display: flex;
}

.search-container input {
    width: 100%;

    padding: 12px;

    border: none;

    outline: none;

    font-size: 16px;
}

.search-container button {
    width: 55px;

    border: none;

    background: #febd69;

    cursor: pointer;
}

.header-buttons {
    display: flex;

    gap: 10px;
}

.header-buttons button {
    padding: 10px;

    border: 1px solid #666;

    background: transparent;

    color: white;

    border-radius: 5px;

    cursor: pointer;
}


/* CATEGORY */

.categories {
    background: #232f3e;

    padding: 10px 25px;

    display: flex;

    gap: 10px;
}

.categories button {
    background: transparent;

    color: white;

    border: none;

    padding: 8px 15px;

    cursor: pointer;

    border-radius: 4px;
}

.categories button:hover {
    background: #37475a;
}


/* HERO */

.hero {
    min-height: 300px;

    display: flex;

    align-items: center;

    padding: 50px;

    background:
        linear-gradient(
            rgba(0,0,0,0.45),
            rgba(0,0,0,0.45)
        ),
        linear-gradient(
            120deg,
            #ff9900,
            #232f3e
        );

    color: white;
}

.hero h1 {
    font-size: 42px;

    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;

    margin-bottom: 25px;
}

.hero button {
    padding: 13px 25px;

    border: none;

    border-radius: 6px;

    background: #ff9900;

    font-weight: bold;

    cursor: pointer;
}


/* PRODUCTS */

main {
    padding: 30px;
}

main h2 {
    margin-bottom: 25px;
}

.products {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));

    gap: 25px;
}

.product {
    background: white;

    border-radius: 10px;

    padding: 18px;

    box-shadow:
        0 3px 10px rgba(0,0,0,0.1);

    transition: 0.2s;
}

.product:hover {
    transform: translateY(-5px);

    box-shadow:
        0 8px 20px rgba(0,0,0,0.15);
}

.product-image {
    height: 180px;

    display: flex;

    justify-content: center;

    align-items: center;

    background: #f7f7f7;

    border-radius: 8px;

    font-size: 75px;

    margin-bottom: 15px;
}

.product h3 {
    margin-bottom: 8px;
}

.category {
    color: #777;

    font-size: 13px;

    margin-bottom: 10px;
}

.price {
    font-size: 22px;

    font-weight: bold;

    color: #b12704;

    margin-bottom: 12px;
}

.product button {
    width: 100%;

    padding: 11px;

    border: none;

    border-radius: 5px;

    background: #ffd814;

    cursor: pointer;

    font-weight: bold;
}

.product button:hover {
    background: #f7ca00;
}


/* CART */

.cart-panel {
    position: fixed;

    top: 0;

    right: -420px;

    width: 400px;

    height: 100vh;

    background: white;

    z-index: 200;

    box-shadow:
        -5px 0 20px rgba(0,0,0,0.2);

    transition: 0.3s;

    padding: 20px;
}

.cart-panel.active {
    right: 0;
}

.cart-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    border-bottom: 1px solid #ddd;

    padding-bottom: 15px;
}

.cart-header button {
    border: none;

    background: none;

    font-size: 22px;

    cursor: pointer;
}

.cart-item {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 15px 0;

    border-bottom: 1px solid #ddd;
}

.cart-item button {
    background: #e74c3c;

    color: white;

    border: none;

    padding: 5px 10px;

    border-radius: 4px;

    cursor: pointer;
}

.cart-total {
    position: absolute;

    bottom: 20px;

    left: 20px;

    right: 20px;
}

.cart-total button {
    width: 100%;

    margin-top: 15px;

    padding: 13px;

    border: none;

    background: #ff9900;

    border-radius: 5px;

    font-weight: bold;

    cursor: pointer;
}


/* FOOTER */

footer {
    background: #131921;

    color: white;

    text-align: center;

    padding: 40px;

    margin-top: 30px;
}

footer h2 {
    color: #ff9900;

    margin-bottom: 10px;
}


/* MOBILE */

@media (max-width: 700px) {

    header {
        flex-wrap: wrap;
    }

    .logo {
        width: 100%;
    }

    .search-container {
        order: 3;

        width: 100%;
    }

    .hero {
        padding: 30px;

        min-height: 250px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .cart-panel {
        width: 100%;
    }

}
